      "registered_at": "登记时自动写入（ISO 8601）",
      "studio": {
        "repo_key": "训练仓库标识",
        "dataset_code": "Studio dataset code",
        "task_code": "Studio task code（= 模型）",
        "dataset_version": "可选：Studio 数据集/导出快照版本",
        "export_id": "可选：后续导出包 ID",
        "annotation_revision_range": "可选：参与训练的标注版本范围",
        "pulled_at": "可选：拉取时间（ISO 8601）"
